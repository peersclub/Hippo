{
  "name": "@hippo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "SPA kernel for operator admin + partner portal: tokens, chrome CSS, primitives, feedback, shell, hash router, cookie API client. The SDK must NOT depend on this — stop-line + size gate.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spa.css": "./src/css/spa.css"
  },
  "files": [
    "dist",
    "src/css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@hippo/tokens": "workspace:*",
    "@preact/signals": "^2.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
